---
/* Page shell for every screen. Phone-first: content lives in a ~420px column
   that reads as a phone on desktop and goes full-width on a real phone.
   §1.2 TopRails + §1.3 BottomNav mount here when `rails`/`nav` are true. */
import '../styles/global.css';
import TopRails from '../components/TopRails.astro';
import BottomNav from '../components/BottomNav.astro';

interface Props {
  title: string;
  id?: string;          // screen ID badge, e.g. "C5"
  rails?: boolean;      // show top rails (default true)
  nav?: boolean;        // show bottom nav (default true)
  active?: string;      // active bottom-nav key: home|learn|mock|notes|history
  pad?: boolean;        // pad the main area (default true)
}
const { title, id = '', rails = true, nav = true, active = '', pad = true } = Astro.props;
const base = import.meta.env.BASE_URL; // '/' locally, '/REPO/' on GitHub Pages
---
<!doctype html>
<html lang="bn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} · edu-ai mockup</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+Bengali:wght@400;500;600;700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css"
      integrity="sha384-nB0miv6/jRmo5UMMR1wu3Gz6NLsoTkbqJghGIsx//Rlm+ZU03BU6SQNC66uf4l5+"
      crossorigin="anonymous"
    />
    <!-- apply saved dark preference before paint to avoid flash -->
    <script is:inline>
      try {
        if (localStorage.getItem('theme') === 'dark') document.documentElement.classList.add('dark');
      } catch (e) {}
    </script>
  </head>
  <body>
    <!-- desktop: subtle device frame; phone: full-bleed column -->
    <div class="relative mx-auto flex min-h-screen w-full max-w-[420px] flex-col bg-white shadow-xl ring-1 ring-slate-200 dark:bg-slate-900 dark:ring-slate-800">
      {rails && <TopRails active={active} />}
      <slot name="header" />
      <main class:list={["flex-1", pad && "px-4 py-4", nav && "pb-24"]}>
        <slot />
      </main>
      {nav && <BottomNav active={active} />}

      {id && (
        <a href="/" title="স্ক্রিন ডিরেক্টরি" class="fixed bottom-1 left-1 z-50 rounded bg-slate-900/70 px-1.5 py-0.5 font-mono text-[10px] text-white hover:bg-slate-900 dark:bg-white/20">
          {id}
        </a>
      )}
    </div>

    <!-- KaTeX auto-render: \( inline \) and $$ display $$ -->
    <script
      is:inline
      src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/contrib/auto-render.min.js"
      integrity="sha384-43gviWU0YVjaDtb/GhzOouOXtZMP/7XUzwPTstBeZFe/+rCMvRwr4yROQP43s0Xk"
      crossorigin="anonymous"></script>
    <!-- Base-path shim: under a GitHub Pages subpath, prepend the base to our
         hand-written absolute hrefs (/a1-landing → /REPO/a1-landing). No-op when
         base is '/' (local dev / root deploy). -->
    <script is:inline define:vars={{ base }}>
      (function () {
        if (!base || base === '/') return;
        var b = base.replace(/\/$/, '');
        document.querySelectorAll('a[href^="/"]').forEach(function (a) {
          var h = a.getAttribute('href');
          if (!h || h.charAt(1) === '/') return;            // skip protocol-relative //
          if (h === b || h.indexOf(b + '/') === 0) return;  // already prefixed
          a.setAttribute('href', b + h);
        });
      })();
    </script>
    <script is:inline>
      window.toggleDark = function () {
        var r = document.documentElement;
        r.classList.toggle('dark');
        try { localStorage.setItem('theme', r.classList.contains('dark') ? 'dark' : 'light'); } catch (e) {}
      };
      document.addEventListener('DOMContentLoaded', function () {
        if (window.renderMathInElement) {
          window.renderMathInElement(document.body, {
            delimiters: [
              { left: '$$', right: '$$', display: true },
              { left: '\\(', right: '\\)', display: false },
            ],
            throwOnError: false,
          });
        }
      });
    </script>
  </body>
</html>
