---
/* G4 Feedback / bug report — report a bug or request a feature. */
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import Button from '../components/Button.astro';

const types = [
  { icon: '🐞', t: 'বাগ' },
  { icon: '💡', t: 'নতুন আইডিয়া' },
  { icon: '💬', t: 'অন্য কিছু' },
];
---
<Layout title="ফিডব্যাক" id="G4" active="home">
  <h1 class="mb-1 text-lg font-bold">💬 মতামত / সমস্যা</h1>
  <p class="mb-4 text-sm text-slate-500 dark:text-slate-400">কী হয়েছে বলো — আমরা দেখব।</p>

  <div class="mb-3 grid grid-cols-3 gap-2">
    {types.map((t, i) => (
      <button type="button" class:list={['flex flex-col items-center gap-1 rounded-md border py-3 text-xs min-h-touch', i === 0 ? 'border-indigo-500 bg-indigo-50 dark:bg-indigo-500/10' : 'border-slate-200 dark:border-slate-700']}>
        <span class="text-xl">{t.icon}</span>{t.t}
      </button>
    ))}
  </div>

  <Card class="mb-3">
    <label class="text-sm font-medium">বিস্তারিত</label>
    <textarea rows="4" placeholder="কী হয়েছে, কোথায় হয়েছে…" class="mt-1 w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-800"></textarea>
    <button type="button" class="mt-2 flex items-center gap-1.5 text-xs text-indigo-600 dark:text-indigo-400">📎 স্ক্রিনশট যোগ করো (ঐচ্ছিক)</button>
  </Card>

  <Button href="/g4-feedback" full>পাঠাও</Button>
  <p class="mt-3 text-center text-xs text-slate-400">পাঠানোর পর: "ধন্যবাদ! আমরা দেখব।"</p>
</Layout>
