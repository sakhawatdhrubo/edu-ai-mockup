---
/* C8 Session — notes panel (slide-out). Capture learning without a blank page.
   Shown here as the panel open over the session. */
import Layout from '../layouts/Layout.astro';
import SessionBar from '../components/SessionBar.astro';
import Card from '../components/Card.astro';
import Button from '../components/Button.astro';
import Pill from '../components/Pill.astro';
---
<Layout title="নোট প্যানেল" id="C8" rails={false} active="learn">
  <SessionBar phase="ধাপ ৩ · নোট" step={3} timer="০৬:১২" slot="header" />

  <div class="mb-3 flex items-center justify-between">
    <h1 class="text-sm font-bold">🗂 এই সেশনের নোট</h1>
    <a href="/e5-notes-library" class="text-xs text-indigo-600 underline dark:text-indigo-400">সব নোট →</a>
  </div>

  <!-- Auto-draft summary + flashcards -->
  <Card tone="sky" class="mb-3">
    <div class="flex items-center gap-2 text-xs font-medium text-sky-700 dark:text-sky-300"><span>✍️</span> স্বয়ংক্রিয় সারাংশ <Pill tone="sky">Scribe</Pill></div>
    <p class="mt-1.5 text-sm">ত্বরণ = বেগের পরিবর্তনের হার। সূত্র a = (v−u)/t। শুরুর বেগ ০ ধরে নিতে ভুলো না।</p>
    <div class="mt-2 flex gap-2 text-xs">
      <span class="rounded-md border border-sky-200 px-2 py-1 dark:border-sky-500/30">কার্ড: a-এর সূত্র?</span>
      <span class="rounded-md border border-sky-200 px-2 py-1 dark:border-sky-500/30">কার্ড: একক?</span>
    </div>
  </Card>

  <!-- Highlight-to-save -->
  <Card class="mb-3">
    <p class="text-xs text-slate-400">ব্যাখ্যা থেকে সংরক্ষিত</p>
    <p class="mt-1 border-l-2 border-amber-400 pl-2 text-sm">"ত্বরণ = একক সময়ে বেগের পরিবর্তন।"</p>
  </Card>

  <!-- Free note -->
  <label class="mb-1 block text-xs font-medium text-slate-500">নিজের নোট</label>
  <textarea rows="3" placeholder="এখানে নিজের কথা লেখো…" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-800"></textarea>
  <Button href="/c8-notes" full class="mt-3">সংরক্ষণ করো</Button>
</Layout>
