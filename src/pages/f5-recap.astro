---
/* F5 Annual / term recap — shareable "your learning" card for pride +
   word-of-mouth. */
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import Button from '../components/Button.astro';

const stats = [
  { v: '১৪২', k: 'session' },
  { v: '৩৮ ঘন্টা', k: 'শেখা' },
  { v: '১২', k: 'concept মাস্টার' },
  { v: '৯', k: 'ভুল-বোঝা ঠিক' },
];
---
<Layout title="বার্ষিক recap" id="F5" active="home">
  <h1 class="mb-3 text-lg font-bold">🎉 তোমার শেখার গল্প</h1>

  <!-- shareable card -->
  <div class="mb-4 rounded-2xl bg-gradient-to-br from-violet-600 to-indigo-700 p-5 text-white shadow-lg">
    <div class="text-xs font-medium text-violet-200">২০২৬ · রিফাত</div>
    <div class="mt-3 grid grid-cols-2 gap-4">
      {stats.map((s) => (
        <div><div class="text-2xl font-bold">{s.v}</div><div class="text-xs text-violet-200">{s.k}</div></div>
      ))}
    </div>
    <div class="mt-4 rounded-lg bg-white/15 p-2 text-center text-sm">🔥 সেরা streak: ৩১ দিন</div>
  </div>

  <div class="flex gap-2">
    <Button href="/g3-invite" full>📤 শেয়ার করো</Button>
    <Button href="/b1-dashboard" variant="ghost">পরে</Button>
  </div>
</Layout>
