---
/* H2 Help index — public. Find answers without support. */
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';

const articles = [
  { t: 'কীভাবে শুরু করব?', slug: 'getting-started' },
  { t: 'mastery / skill-title মানে কী?', slug: 'mastery-meaning' },
  { t: 'streak ও freeze কীভাবে কাজ করে?', slug: 'streak-freeze' },
  { t: 'subscription বাতিল / রিফান্ড', slug: 'cancel-refund' },
  { t: 'আমার data ও প্রাইভেসি', slug: 'privacy' },
];
---
<Layout title="সাহায্য" id="H2" rails={false} nav={false}>
  <div class="mb-4 flex items-center justify-between">
    <h1 class="text-lg font-bold">সাহায্য কেন্দ্র</h1>
    <div class="flex gap-1 rounded-full bg-slate-100 p-0.5 text-xs dark:bg-slate-800">
      <button class="rounded-full bg-white px-2.5 py-1 font-medium shadow-sm dark:bg-slate-700">বাংলা</button>
      <button class="rounded-full px-2.5 py-1 text-slate-500">English</button>
    </div>
  </div>

  <input type="search" placeholder="🔍 প্রশ্ন খুঁজি" class="mb-4 w-full rounded-full border border-slate-300 bg-white px-4 py-2 text-sm dark:border-slate-700 dark:bg-slate-800" />

  <div class="space-y-1.5">
    {articles.map((a) => (
      <a href="/h3-help-article" class="block">
        <Card pad={false} class="flex items-center justify-between p-3"><span class="text-sm">{a.t}</span><span class="text-slate-300">›</span></Card>
      </a>
    ))}
  </div>

  <p class="mt-5 text-center text-xs text-slate-400">উত্তর পাওনি? <a href="/g4-feedback" class="underline">আমাদের লেখো</a> · support@onnorokom.com</p>
</Layout>
