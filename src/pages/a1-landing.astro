---
/* A1 Landing / Demo — public. Sell the promise in 15s; let a visitor feel the
   tutor before signup. */
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
const how = [
  { icon: '📖', t: 'শেখো', d: 'নিজের ভাষায়, নিজের গতিতে' },
  { icon: '✍️', t: 'অনুশীলন', d: 'প্রশ্ন + তাৎক্ষণিক feedback' },
  { icon: '📈', t: 'এগিয়ে যাও', d: 'mastery + পরীক্ষার প্রস্তুতি' },
];
---
<Layout title="Landing" id="A1" rails={false} nav={false} pad={false}>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-indigo-600 to-indigo-700 px-5 pb-8 pt-10 text-white">
    <p class="mb-2 text-xs font-medium uppercase tracking-wider text-indigo-200">Onnorokom EduAI · SSC পদার্থবিজ্ঞান</p>
    <h1 class="text-2xl font-bold leading-snug">তোমার নিজের AI শিক্ষক — বাংলায়, ফোনেই।</h1>
    <p class="mt-2 text-sm text-indigo-100">প্রশ্ন বুঝে, ভুল ধরে, ঠিক জায়গা থেকে শেখায়। পরীক্ষার জন্য তৈরি হও।</p>
    <div class="mt-5 flex flex-col gap-2">
      <Button href="/a3-signup" full>ফ্রি-তে শুরু করো</Button>
      <a href="/a2-login" class="text-center text-sm font-medium text-indigo-100 underline">আগে account আছে? লগইন</a>
    </div>
  </section>

  <div class="space-y-5 px-5 py-6">
    <!-- Demo -->
    <Card tone="violet">
      <p class="text-sm font-semibold text-violet-800 dark:text-violet-200">দেখে নাও — account লাগবে না</p>
      <p class="mt-0.5 text-xs text-violet-700/80 dark:text-violet-300/80">একটি ছোট নমুনা সেশন (Acceleration)।</p>
      <Button href="/c2-greeting" variant="secondary" size="sm" class="mt-3">▶ লগইন ছাড়াই দেখো</Button>
    </Card>

    <!-- How it works -->
    <section>
      <h2 class="mb-2 text-sm font-bold text-slate-700 dark:text-slate-200">কীভাবে কাজ করে</h2>
      <div class="grid grid-cols-3 gap-2">
        {how.map((h) => (
          <Card class="text-center">
            <div class="text-2xl">{h.icon}</div>
            <div class="mt-1 text-sm font-semibold">{h.t}</div>
            <div class="mt-0.5 text-[11px] text-slate-500 dark:text-slate-400">{h.d}</div>
          </Card>
        ))}
      </div>
    </section>

    <!-- Trust strip -->
    <div class="flex flex-wrap justify-center gap-2 text-xs text-slate-500 dark:text-slate-400">
      <span class="rounded-full bg-slate-100 px-2 py-1 dark:bg-slate-800">🇧🇩 Bangla-first</span>
      <span class="rounded-full bg-slate-100 px-2 py-1 dark:bg-slate-800">📱 phone-first</span>
      <span class="rounded-full bg-slate-100 px-2 py-1 dark:bg-slate-800">🎯 পরীক্ষার জন্য</span>
    </div>

    <!-- Referral note -->
    <p class="text-center text-xs text-slate-400">
      বন্ধু আমন্ত্রণ করেছে? <a href="/a3-signup" class="font-medium text-indigo-600 dark:text-indigo-400">কোড দিয়ে শুরু করো →</a>
    </p>
  </div>
</Layout>
