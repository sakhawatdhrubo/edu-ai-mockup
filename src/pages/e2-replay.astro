---
/* E2 Session replay — read-only timeline of a session. */
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import Pill from '../components/Pill.astro';

const steps = [
  { t: '১২:০০', k: 'engage', body: 'পূর্বানুমান: পালক ও পাথর একসাথে পড়বে ✓', tone: 'violet' },
  { t: '১২:০৩', k: 'ব্যাখ্যা', body: 'ত্বরণ (worked-example) দেখা হলো', tone: 'sky' },
  { t: '১২:০৫', k: 'প্রশ্ন ১', body: 'উত্তর 4 m/s² · সঠিক', tone: 'emerald' },
  { t: '১২:০৭', k: 'প্রশ্ন ২', body: 'উত্তর 100 · ভুল → reteach', tone: 'rose' },
  { t: '১২:০৮', k: 'হিন্ট', body: 'স্তর ২ ব্যবহার হলো', tone: 'amber' },
  { t: '১২:১০', k: 'প্রশ্ন ২ (পুনঃ)', body: 'উত্তর 4 m/s² · সঠিক', tone: 'emerald' },
];
---
<Layout title="রিপ্লে" id="E2" active="history">
  <a href="/e1-history" class="text-sm text-slate-500 dark:text-slate-400">← ইতিহাস</a>
  <h1 class="mt-1 mb-1 text-lg font-bold">Acceleration · রিপ্লে</h1>
  <p class="mb-4 text-xs text-slate-400">৪ জুন · ২৬ মিনিট · পড়া-শুধু</p>

  <ol class="relative ml-3 border-l border-slate-200 dark:border-slate-700">
    {steps.map((s) => (
      <li class="mb-4 ml-4">
        <span class="absolute -left-1.5 mt-1.5 h-3 w-3 rounded-full border-2 border-white bg-slate-300 dark:border-slate-900 dark:bg-slate-600"></span>
        <div class="flex items-center gap-2">
          <span class="font-mono text-xs text-slate-400">{s.t}</span>
          <Pill tone={s.tone}>{s.k}</Pill>
        </div>
        <p class="mt-1 text-sm">{s.body}</p>
      </li>
    ))}
  </ol>
</Layout>
