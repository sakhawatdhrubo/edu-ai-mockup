---
/* Prototype home — clickable directory of every screen, grouped by zone A–I.
   This is the entry point for reviewing the mockup. */
import Layout from '../layouts/Layout.astro';
import { zones } from '../data/screens.js';
const total = zones.reduce((n, z) => n + z.screens.length, 0);
const accent = {
  indigo: 'text-indigo-600 dark:text-indigo-400',
  emerald: 'text-emerald-600 dark:text-emerald-400',
  violet: 'text-violet-600 dark:text-violet-400',
  amber: 'text-amber-600 dark:text-amber-400',
  sky: 'text-sky-600 dark:text-sky-400',
  rose: 'text-rose-600 dark:text-rose-400',
  slate: 'text-slate-600 dark:text-slate-400',
};
const zoneColor = { A: 'indigo', B: 'emerald', C: 'violet', D: 'amber', E: 'sky', F: 'rose', G: 'slate', H: 'indigo', I: 'emerald' };
---
<Layout title="স্ক্রিন ডিরেক্টরি" rails={false} nav={false}>
  <header class="mb-5 border-b border-slate-200 pb-4 dark:border-slate-800">
    <div class="mb-1 flex items-center gap-2">
      <span class="grid h-9 w-9 place-items-center rounded-md bg-indigo-600 text-white">e</span>
      <h1 class="text-lg font-bold">edu-ai · Student UI mockup</h1>
    </div>
    <p class="text-sm text-slate-500 dark:text-slate-400">
      Bangla-first SSC physics tutor — {total}টি স্ক্রিন, zone A–I। যেকোনো স্ক্রিনে ট্যাপ করো।
    </p>
    <div class="mt-3 flex gap-2">
      <a href="/a1-landing" class="inline-flex min-h-touch items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white hover:bg-indigo-700">▶ যাত্রা শুরু (A1)</a>
      <button type="button" onclick="toggleDark()" class="inline-flex min-h-touch items-center rounded-md border border-slate-300 px-3 py-2 text-sm font-medium dark:border-slate-700">🌙 ডার্ক</button>
    </div>
  </header>

  {zones.map((z) => (
    <section class="mb-5">
      <h2 class="mb-2 flex items-baseline gap-2 text-sm font-bold uppercase tracking-wide">
        <span class={accent[zoneColor[z.key]]}>{z.key}</span>
        <span>{z.title}</span>
        <span class="text-xs font-normal text-slate-400">· {z.desc}</span>
      </h2>
      <ul class="grid grid-cols-1 gap-1.5">
        {z.screens.map((s) => (
          <li>
            <a href={`/${s.slug}`} class="flex items-center gap-3 rounded-md border border-slate-200 bg-white px-3 py-2.5 text-sm hover:border-indigo-300 hover:bg-indigo-50/50 dark:border-slate-800 dark:bg-slate-900 dark:hover:border-indigo-500/40">
              <span class="w-12 shrink-0 font-mono text-xs font-semibold text-slate-400">{s.id}</span>
              <span class="flex-1">{s.title}</span>
              <span class="text-slate-300">›</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}

  <footer class="border-t border-slate-200 pt-4 text-center text-xs text-slate-400 dark:border-slate-800">
    ডিজাইন মকআপ — backend/data নেই। spec: <code>student_wireframe.md</code>
  </footer>
</Layout>
