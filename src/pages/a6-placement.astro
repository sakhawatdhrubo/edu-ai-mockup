---
/* A6 Placement test — adaptive diagnostic (running state). */
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import ProgressBar from '../components/ProgressBar.astro';
import Card from '../components/Card.astro';
import Math from '../components/Math.astro';
const opts = [
  { k: 'ক', t: 'বেগ বাড়তে থাকবে', sel: false },
  { k: 'খ', t: 'বেগ ধ্রুব থাকবে', sel: true },
  { k: 'গ', t: 'বস্তু থেমে যাবে', sel: false },
  { k: 'ঘ', t: 'বেগ কমতে থাকবে', sel: false },
];
---
<Layout title="Placement" id="A6" rails={false} nav={false}>
  <div class="py-4">
    <div class="mb-3 flex items-center justify-between">
      <span class="text-sm font-semibold">🎯 Placement</span>
      <span class="text-xs text-slate-400">~১০ মিনিট</span>
    </div>
    <p class="mb-2 text-xs text-slate-500 dark:text-slate-400">১০টি প্রশ্ন — সঠিক / ভুল কোনোটাতেই অসুবিধা নেই।</p>
    <ProgressBar value={4} max={10} tone="indigo" label="প্রশ্ন ৪ / ১০" class="mb-5" />

    <Card>
      <p class="text-xs font-medium text-slate-400">প্রশ্ন · adaptive</p>
      <p class="mt-1 text-sm leading-relaxed">
        একটি বস্তুর উপর কোনো নিট বল কাজ না করলে (<Math tex="F_{net}=0" />) তার গতি সম্পর্কে কী বলা যায়?
      </p>
      <div class="mt-4 space-y-2">
        {opts.map((o) => (
          <label class:list={[
            'flex items-center gap-3 rounded-md border px-3 py-2.5 min-h-touch',
            o.sel ? 'border-indigo-500 bg-indigo-50 dark:bg-indigo-500/10' : 'border-slate-200 dark:border-slate-700',
          ]}>
            <span class:list={['grid h-6 w-6 place-items-center rounded-full border text-xs font-bold', o.sel ? 'border-indigo-500 bg-indigo-600 text-white' : 'border-slate-300 text-slate-500 dark:border-slate-600']}>{o.k}</span>
            <span class="text-sm">{o.t}</span>
          </label>
        ))}
      </div>
    </Card>

    <Button href="/a7-placement-result" full class="mt-5">জমা দিন</Button>
    <p class="mt-3 text-center text-xs text-slate-400">
      <a href="/a7-placement-result" class="underline">skip → Home (warm-up mode)</a>
    </p>
  </div>
</Layout>
