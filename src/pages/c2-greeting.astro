---
/* C2 Session — greeting + engage. Frame why this topic, then prime with a
   prediction committed before teaching. */
import Layout from '../layouts/Layout.astro';
import SessionBar from '../components/SessionBar.astro';
import Card from '../components/Card.astro';
import Button from '../components/Button.astro';
import Banner from '../components/Banner.astro';
import Why from '../components/Why.astro';
---
<Layout title="সেশন · শুরু" id="C2" rails={false} active="learn">
  <SessionBar phase="ধাপ ১ · শুরু" step={2} timer="০০:১২" slot="header" />
  <div class="space-y-4">
    <!-- Greeting -->
    <Card>
      <p class="text-sm leading-relaxed">রিফাত, কেমন আছো? কাল ছিল Velocity — তুমি ৭/১০ ঠিক করেছিলে। আজ <span class="font-semibold">Acceleration</span> — শুরু করি?</p>
      <div class="mt-2"><Why label="কেন এই concept?">Velocity বুঝে ফেলেছ; Acceleration তার পরের ধাপ এবং পরীক্ষায় বেশি আসে।</Why></div>
    </Card>

    <!-- Engage hook + prediction -->
    <Card tone="violet">
      <p class="text-sm font-semibold text-violet-800 dark:text-violet-200">একটু ভাবো 🤔</p>
      <p class="mt-1 text-sm">একটি পালক আর একটি পাথর vacuum-এ একসাথে ছাড়লে — কোনটা আগে নিচে পৌঁছাবে?</p>
      <div class="mt-3 space-y-2">
        {['পাথর আগে', 'পালক আগে', 'একসাথে পৌঁছাবে'].map((o, i) => (
          <label class:list={['flex items-center gap-2 rounded-md border px-3 py-2 text-sm min-h-touch', i === 2 ? 'border-violet-400 bg-white dark:bg-slate-900' : 'border-slate-200 dark:border-slate-700']}>
            <input type="radio" name="predict" class="accent-violet-600" checked={i === 2} /> {o}
          </label>
        ))}
      </div>
      <p class="mt-2 text-[11px] text-violet-700/70 dark:text-violet-300/70">উত্তর জানা না থাকলেও আন্দাজ করো — এতে শেখা ভালো হয়।</p>
    </Card>

    <Button href="/c3-explanation" full>উত্তর দিয়ে এগোও →</Button>
  </div>
</Layout>
