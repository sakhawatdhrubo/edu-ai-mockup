---
/* H1 Report / Crisis — overlay in /tutor. Flag bad content; catch distress.
   Shown here as the report modal open, plus the crisis-referral state below. */
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';

const reasons = ['ভুল তথ্য', 'অপ্রাসঙ্গিক', 'অস্পষ্ট / বুঝিনি', 'অন্য সমস্যা'];
---
<Layout title="Report" id="H1" rails={false} nav={false} pad={false}>
  <div class="p-4 text-sm text-slate-400">টিউটরের reply-র নিচে ⚠ থেকে Report খোলা…</div>

  <!-- Report modal -->
  <div class="absolute inset-0 z-50 flex items-end bg-slate-900/50">
    <a href="/c3-explanation" class="absolute inset-0" aria-label="বন্ধ"></a>
    <div class="relative w-full rounded-t-2xl bg-white p-5 dark:bg-slate-900">
      <div class="mb-3 flex items-center"><h2 class="text-base font-bold">এই reply তে কী সমস্যা?</h2><a href="/c3-explanation" class="ml-auto text-slate-400">✕</a></div>
      <div class="space-y-2">
        {reasons.map((r, i) => (
          <label class="flex items-center gap-2 rounded-md border border-slate-200 px-3 py-2.5 text-sm min-h-touch dark:border-slate-700">
            <input type="radio" name="reason" class="accent-rose-600" checked={i === 0} /> {r}
          </label>
        ))}
      </div>
      <textarea rows="2" placeholder="বিস্তারিত (ঐচ্ছিক)" class="mt-2 w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-800"></textarea>
      <Button href="/c3-explanation" variant="danger" full class="mt-3">Submit</Button>

      <!-- crisis referral (distress signal) -->
      <Card tone="violet" class="mt-4">
        <p class="text-sm">তুমি যদি কঠিন সময়ের মধ্যে থাকো — বিশ্বস্ত কারো সাথে কথা বলো (পরিবার, বন্ধু, teacher)। সাহায্য আছে:</p>
        <p class="mt-1 text-sm font-semibold">📞 কান পেতে রই — ৯৬১২১১৯৯২৪</p>
      </Card>
    </div>
  </div>
</Layout>
