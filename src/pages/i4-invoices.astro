---
/* I4 Invoices — receipts + cancel/pause. */
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import Button from '../components/Button.astro';

const invoices = [
  { date: '১ জুন ২০২৬', amt: '৳২৯৯', status: 'পরিশোধিত' },
  { date: '১ মে ২০২৬', amt: '৳২৯৯', status: 'পরিশোধিত' },
  { date: '১ এপ্রিল ২০২৬', amt: '৳০', status: 'ট্রায়াল' },
];
---
<Layout title="ইনভয়েস" id="I4" active="home">
  <h1 class="mb-4 text-lg font-bold">🧾 রসিদ</h1>

  <Card pad={false} class="mb-4 divide-y divide-slate-100 dark:divide-slate-800">
    {invoices.map((iv) => (
      <div class="flex items-center gap-3 px-4 py-3">
        <div class="flex-1"><div class="text-sm font-medium">{iv.date}</div><div class="text-xs text-emerald-600 dark:text-emerald-400">{iv.status}</div></div>
        <span class="text-sm font-semibold">{iv.amt}</span>
        <a href="#" class="text-xs text-indigo-600 underline dark:text-indigo-400">⬇</a>
      </div>
    ))}
  </Card>

  <Card>
    <h2 class="text-sm font-semibold">সাবস্ক্রিপশন</h2>
    <p class="mt-0.5 text-xs text-slate-500 dark:text-slate-400">Pro · পরের বিল ১ জুলাই ২০২৬</p>
    <div class="mt-3 flex gap-2">
      <Button href="/i4-invoices" variant="secondary" size="sm">⏸ থামাও</Button>
      <Button href="/i4-invoices" variant="ghost" size="sm">বাতিল করো</Button>
    </div>
  </Card>
</Layout>
