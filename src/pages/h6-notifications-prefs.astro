---
/* H6 Notification preferences — per-channel opt-in + quiet hours. */
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';

const channels = [
  { t: 'In-app', on: true },
  { t: 'SMS', on: true },
  { t: 'WhatsApp', on: false },
  { t: 'ইমেইল', on: false },
];
const kinds = [
  { t: 'পুনঃ-পরীক্ষা মনে করানো', on: true },
  { t: 'streak রিমাইন্ডার', on: true },
  { t: 'মক রেডি', on: true },
  { t: 'অভিভাবকের বার্তা', on: true },
];
---
<Layout title="নোটিফিকেশন প্রেফারেন্স" id="H6" active="home">
  <a href="/h4-settings" class="text-sm text-slate-500 dark:text-slate-400">← সেটিংস</a>
  <h1 class="mt-1 mb-4 text-lg font-bold">🔔 নোটিফিকেশন</h1>

  <h2 class="mb-1.5 text-xs font-semibold uppercase text-slate-400">চ্যানেল</h2>
  <Card pad={false} class="mb-4 divide-y divide-slate-100 dark:divide-slate-800">
    {channels.map((c) => (
      <div class="flex items-center px-4 py-3"><span class="flex-1 text-sm">{c.t}</span>
        <span class:list={['h-6 w-11 rounded-full p-0.5', c.on ? 'bg-indigo-600' : 'bg-slate-300 dark:bg-slate-700']}><span class:list={['block h-5 w-5 rounded-full bg-white', c.on && 'translate-x-5']}></span></span>
      </div>
    ))}
  </Card>

  <h2 class="mb-1.5 text-xs font-semibold uppercase text-slate-400">কী জন্য</h2>
  <Card pad={false} class="mb-4 divide-y divide-slate-100 dark:divide-slate-800">
    {kinds.map((c) => (
      <div class="flex items-center px-4 py-3"><span class="flex-1 text-sm">{c.t}</span>
        <span class:list={['h-6 w-11 rounded-full p-0.5', c.on ? 'bg-indigo-600' : 'bg-slate-300 dark:bg-slate-700']}><span class:list={['block h-5 w-5 rounded-full bg-white', c.on && 'translate-x-5']}></span></span>
      </div>
    ))}
  </Card>

  <Card>
    <h2 class="text-sm font-semibold">🌙 শান্ত-সময় (quiet hours)</h2>
    <p class="mt-0.5 text-xs text-slate-400">এই সময়ে কোনো notification আসবে না।</p>
    <div class="mt-2 flex items-center gap-2 text-sm"><input type="text" value="রাত ১০:০০" class="flex-1 rounded-md border border-slate-300 bg-white px-3 py-2 dark:border-slate-700 dark:bg-slate-800" /><span>—</span><input type="text" value="সকাল ৭:০০" class="flex-1 rounded-md border border-slate-300 bg-white px-3 py-2 dark:border-slate-700 dark:bg-slate-800" /></div>
  </Card>
</Layout>
