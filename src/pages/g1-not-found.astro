---
/* G1 Not-found / broken link — friendly recovery so a bad/expired link never
   disorients. */
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
---
<Layout title="পাওয়া যায়নি" id="G1" rails={false} nav={false}>
  <div class="flex min-h-[80vh] flex-col items-center justify-center text-center">
    <div class="text-5xl">🧭</div>
    <h1 class="mt-3 text-xl font-bold">এই page পাওয়া গেল না</h1>
    <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">হয়তো link পুরোনো বা ভুল।</p>
    <div class="mt-6 flex flex-col gap-2">
      <Button href="/b1-dashboard" full>হোমে ফিরে যাও</Button>
      <a href="/h2-help" class="text-sm font-medium text-slate-500 dark:text-slate-400">সাহায্য কেন্দ্র</a>
    </div>
  </div>
</Layout>
