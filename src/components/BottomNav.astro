---
/* §1.3 Bottom nav — 5 fixed tabs, active tab indigo. Mobile-only feel, but
   shown on every in-app screen in this mockup. */
interface Props { active?: string }
const { active = '' } = Astro.props;
const tabs = [
  { key: 'home', label: 'হোম', icon: '🏠', href: '/b1-dashboard' },
  { key: 'learn', label: 'পড়া', icon: '▶', href: '/c1-chooser' },
  { key: 'mock', label: 'মক', icon: '📝', href: '/d1-mock-setup' },
  { key: 'notes', label: 'নোট', icon: '🗂', href: '/e5-notes-library' },
  { key: 'history', label: 'ইতিহাস', icon: '📜', href: '/e1-history' },
];
---
<nav class="fixed inset-x-0 bottom-0 z-40 mx-auto flex w-full max-w-[420px] border-t border-slate-200 bg-white/95 backdrop-blur dark:border-slate-800 dark:bg-slate-900/95">
  {tabs.map((t) => (
    <a
      href={t.href}
      class:list={[
        'flex flex-1 flex-col items-center gap-0.5 py-2 text-[11px] min-h-touch justify-center',
        active === t.key
          ? 'text-indigo-600 dark:text-indigo-400 font-semibold'
          : 'text-slate-500 dark:text-slate-400',
      ]}
    >
      <span class="text-lg leading-none">{t.icon}</span>
      <span>{t.label}</span>
    </a>
  ))}
</nav>
