---
/* Session shell top bar (persistent across C2–C11). Phase indicator · timer ·
   modality switcher · 📘 formula · ◼ pause. */
interface Props {
  phase?: string;       // e.g. "ধাপ ৪ · প্রশ্ন ৩/১০"
  step?: number;        // active dot index (0-based) into the phase dots
  timer?: string;       // e.g. "১২:০৪"
}
const { phase = '', step = 0, timer = '১২:০৪' } = Astro.props;
const dots = ['greet', 'warmup', 'engage', 'explain', 'practice', 'transfer', 'teach', 'summary'];
---
<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/95 px-3 py-2 backdrop-blur dark:border-slate-800 dark:bg-slate-900/95">
  <div class="flex items-center gap-2">
    <a href="/b1-dashboard" aria-label="হোম" class="grid h-8 w-8 place-items-center rounded-md hover:bg-slate-100 dark:hover:bg-slate-800">←</a>
    <span class="flex-1 truncate text-xs font-semibold text-slate-600 dark:text-slate-300">{phase}</span>
    <span class="rounded bg-slate-100 px-1.5 py-0.5 font-mono text-xs text-slate-500 dark:bg-slate-800">⏱ {timer}</span>
    <a href="/c3-explanation" aria-label="মডালিটি" class="grid h-8 w-8 place-items-center rounded-md hover:bg-slate-100 dark:hover:bg-slate-800">🔀</a>
    <a href="/d4-formula-sheet" aria-label="ফর্মুলা" class="grid h-8 w-8 place-items-center rounded-md hover:bg-slate-100 dark:hover:bg-slate-800">📘</a>
    <a href="/c10-controls" aria-label="বিরতি" class="grid h-8 w-8 place-items-center rounded-md hover:bg-slate-100 dark:hover:bg-slate-800">◼</a>
  </div>
  <div class="mt-1.5 flex items-center gap-1">
    {dots.map((_, i) => (
      <span class:list={['h-1 flex-1 rounded-full', i < step ? 'bg-indigo-500' : i === step ? 'bg-indigo-400' : 'bg-slate-200 dark:bg-slate-700']}></span>
    ))}
  </div>
</header>
