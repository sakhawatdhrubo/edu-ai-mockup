---
/* §1.6 Transparency — a tappable "কেন?" that progressively discloses a
   plain-Bangla reason for a system decision. */
interface Props { label?: string }
const { label = 'কেন?' } = Astro.props;
---
<details class="group inline-block text-xs">
  <summary class="inline-flex cursor-pointer list-none items-center gap-1 rounded-full bg-slate-100 px-2 py-0.5 font-medium text-slate-600 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300">
    <span aria-hidden="true">ⓘ</span>{label}
  </summary>
  <p class="mt-1.5 rounded-md border border-slate-200 bg-white p-2 text-slate-600 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300">
    <slot />
  </p>
</details>
