---
/* Shared button (§1.4). variant: primary | secondary | ghost | danger.
   Renders <a> when href is set, else <button>. One primary action per screen. */
interface Props {
  variant?: 'primary' | 'secondary' | 'ghost' | 'danger';
  href?: string;
  full?: boolean;
  size?: 'md' | 'sm';
  type?: 'button' | 'submit';
  class?: string;
}
const { variant = 'primary', href, full = false, size = 'md', type = 'button', class: cls = '' } = Astro.props;
const base = 'inline-flex items-center justify-center gap-1.5 rounded-md font-semibold transition select-none min-h-touch';
const sizes = { md: 'px-4 py-2.5 text-sm', sm: 'px-3 py-1.5 text-xs min-h-0' };
const variants = {
  primary: 'bg-indigo-600 text-white hover:bg-indigo-700 active:bg-indigo-800',
  secondary: 'border border-indigo-600 text-indigo-700 hover:bg-indigo-50 dark:text-indigo-300 dark:hover:bg-indigo-500/10',
  ghost: 'text-indigo-700 hover:bg-indigo-50 dark:text-indigo-300 dark:hover:bg-indigo-500/10',
  danger: 'bg-rose-600 text-white hover:bg-rose-700',
};
const cn = [base, sizes[size], variants[variant], full && 'w-full', cls].filter(Boolean).join(' ');
---
{href ? (
  <a href={href} class={cn}><slot /></a>
) : (
  <button type={type} class={cn}><slot /></button>
)}
